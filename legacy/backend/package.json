{
  "name": "berkeley-navigator-kb",
  "version": "0.1.0",
  "description": "Berkeley Navigator — Course Knowledge Base (data + retrieval layer MVP)",
  "scripts": {
    "db:init": "tsx src/db/init.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "tsx src/db/init.ts --reset && tsx src/db/seed.ts",
    "dev": "tsx src/api/server.ts",
    "start": "tsx src/api/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "collect:check": "tsx scripts/collect_courses/check_sources.ts"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
