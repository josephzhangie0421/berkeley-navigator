# ---------------------------------------------------------------
# Berkeley Navigator frontend configuration
# Copy to .env.local and edit. Never commit .env.local.
# ---------------------------------------------------------------

# "mock" (default): simulated answers for interface testing, no backend needed.
# "live": answers come from the course retrieval backend via /api/chat.
# NEXT_PUBLIC_ vars are baked in at build time: rebuild after changing.
NEXT_PUBLIC_DATA_MODE=mock

# --- Live mode only (server-side, never sent to the browser) ---

# Base URL of the backend that serves POST /api/retrieve
RETRIEVAL_API_BASE_URL=http://localhost:8000
# Optional bearer token, if the backend requires one
RETRIEVAL_API_KEY=
# Optional timeout in milliseconds (default 15000)
RETRIEVAL_API_TIMEOUT_MS=

# Optional: enables AI answer generation. Without it, live mode shows
# retrieved evidence without an AI summary ("evidence-only").
ANTHROPIC_API_KEY=
# Optional model override (default claude-sonnet-5-5)
LLM_MODEL=
# Optional timeout in milliseconds (default 45000)
LLM_TIMEOUT_MS=
