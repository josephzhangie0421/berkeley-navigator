# Berkeley Navigator monorepo — root ignore rules.
# backend/.gitignore and frontend/.gitignore still apply inside each project.

# ---- Dependencies ----
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---- Secrets and local environment files ----
# Keep only the documented templates.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials*.json
service-account*.json

# ---- Build output ----
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts
.vercel/
.turbo/

# ---- Local databases ----
.pglite/
*.db
*.sqlite
*.sqlite3
*.db-journal
pgdata/

# ---- Test / coverage output ----
coverage/
.nyc_output/
test-results/
playwright-report/
.vitest/

# ---- Source re-verification snapshots (raw fetched pages) ----
backend/scripts/collect_courses/snapshots/

# ---- Research data (belongs to the Research & Validation workstream, never this repo) ----
research-data/
interviews/
user-testing/
*.transcript.*
consent-forms/
feedback-export*/

# ---- Logs and temp files ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs/
tmp/
temp/
*.tmp
*.swp
*.swo
*~

# ---- OS / editor ----
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json

# Python and local ingestion
.venv/
__pycache__/
.pytest_cache/
*.pyc
.local/
