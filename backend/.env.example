# Copy to .env and fill in. Never commit real credentials.

# PostgreSQL / Supabase connection string. Leave empty to use embedded PGlite (no install needed).
# Supabase: Project Settings → Database → Connection string (URI)
DATABASE_URL=

# Where PGlite stores data when DATABASE_URL is empty. Use "memory" for a throwaway in-memory DB.
PGLITE_DATA_DIR=./.pglite

# API port
PORT=3001

# CORS origin allowed to call the API (frontend dev server). "*" allows any origin.
ALLOWED_ORIGIN=http://localhost:3000

# Optional: run the test suite against a real Postgres instead of in-memory PGlite.
TEST_DATABASE_URL=

# Optional: User-Agent used by scripts/collect_courses/check_sources.ts
COLLECT_USER_AGENT=
