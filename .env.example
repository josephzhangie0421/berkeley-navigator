APP_ENV=development
DATABASE_URL=
# Use a separate administrative connection for migrations; backend should be read-only.
MIGRATION_DATABASE_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
MAX_TOOL_CALLS=8
MAX_MODEL_ROUNDS=4
MODEL_TIMEOUT_SECONDS=30
# Isolated integration schema on a dedicated development/test database only.
TEST_DATABASE_URL=
RUN_LIVE_GEMINI=0
